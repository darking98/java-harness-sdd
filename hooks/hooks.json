{
  "description": "java-harness-sdd: permisos de escritura por rol, verificación rápida cuando cambió el código, persistencia del veredicto del reviewer y aviso de versión. No hace nada en repos sin .harness/harness.conf local.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-status.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-app-code.sh\""
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/persist-review.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "java-harness-sdd:implementer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-on-stop.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "java-harness-sdd:reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/persist-review.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/verify-on-stop.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
